{
  "name": "workradar",
  "private": true,
  "version": "1.0.0",
  "description": "WorkRadar: one AI-assisted view of what a manager's team is doing, what needs attention, and who is blocked.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:server\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/to-artifact.mjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.12"
  }
}
