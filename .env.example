# Copy to .env and fill in. Never commit .env.

# --- AI (free) -------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey (free tier, no card needed).
GEMINI_API_KEY=
# Optional. The daily briefing uses GEMINI_MODEL; short drafts use the faster
# GEMINI_DRAFT_MODEL. Any model your key can use on the free tier.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DRAFT_MODEL=gemini-3.5-flash-lite

# --- Sources -------------------------------------------------------------------
# Add and manage sources (GitHub, Google Calendar, Google Tasks, JSON feeds,
# webhooks) on the Sources page. The GITHUB_* values below only seed a first
# GitHub source the very first time the server starts.
# Comma-separated repositories to watch.
GITHUB_REPOS=tashok7003/workradar-app
# Your GitHub login: work waiting on this person shows as "blocked on you".
GITHUB_MANAGER=tashok7003
# Optional display names and roles: login:Name:Role, comma-separated.
GITHUB_TEAM=tashok7003:Ashok:Engineering manager
# Optional but recommended (60 requests/hour without it, 5,000 with it).
# Fine-grained token, read-only: Metadata, Issues, Pull requests, Commit statuses / Checks.
GITHUB_TOKEN=

# --- Google Calendar and Google Tasks (optional) -------------------------------
# OAuth client from Google Cloud Console (see README → Google setup).
# Redirect URI to register: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Server ------------------------------------------------------------------
PORT=8787
# The address you open WorkRadar at. Used for the Google redirect and webhook URLs.
PUBLIC_URL=http://localhost:5173
# Required to manage sources from anywhere other than this computer (e.g. on Render).
ADMIN_TOKEN=
# Your name as shown in the app (defaults to your GitHub display name).
ME_NAME=
# Where sources, the Google sign-in and webhook items are saved.
DATA_DIR=data
# Allow JSON feeds on private network addresses in production (off by default).
# ALLOW_PRIVATE_FEEDS=1
