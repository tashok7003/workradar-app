# Copy to .env and fill in. Never commit .env.

# --- AI (free) -------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey (free tier, no card needed).
GEMINI_API_KEY=
# Optional. Any model your key can use on the free tier.
GEMINI_MODEL=gemini-3.8-flash

# --- Live GitHub data --------------------------------------------------------
# Comma-separated repositories to watch.
GITHUB_REPOS=tashok7003/workradar-app
# Your GitHub login: work waiting on this person shows as "blocked on you".
GITHUB_MANAGER=tashok7003
# Optional display names and roles: login:Name:Role, comma-separated.
GITHUB_TEAM=tashok7003:Ashok:Engineering manager
# Optional but recommended (60 requests/hour without it, 5,000 with it).
# Fine-grained token, read-only: Metadata, Issues, Pull requests, Commit statuses / Checks.
GITHUB_TOKEN=

# --- Server ------------------------------------------------------------------
PORT=8787
